# Copiar a server/.env para desarrollo local.
# En produccion estas variables NO van en este archivo: se configuran en
# Plesk > Node.js > Environment Variables.

MONGODB_URI=mongodb://localhost:27017/linksight
JWT_SECRET=cadena-aleatoria-larga-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:5173
PORT=3001
NODE_ENV=development

# API key de solo lectura para servicios externos (p. ej. nexo).
# Opcional: sin estas variables el guard es un no-op y todo sigue igual.
# Generar la clave con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LINKSIGHT_API_USER_ID es el _id de MongoDB del usuario cuyas metricas se exponen.
# Solo autoriza peticiones GET en /api/planner/analytics/publico.
LINKSIGHT_API_KEY=
LINKSIGHT_API_USER_ID=
